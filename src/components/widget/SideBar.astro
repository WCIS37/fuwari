---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "home-journal-sidebar w-full"]}>
    <span class="home-journal-leaf-emboss" aria-hidden="true"><i></i><i></i></span>
    <span class="home-journal-sprig home-journal-sprig-top" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="home-journal-sprig home-journal-sprig-bottom" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="home-journal-profile flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div class="home-journal-caption" aria-hidden="true"><span>Explore the journey</span></div>
    <div id="sidebar-sticky" class="home-journal-directory transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
    </div>
</div>
